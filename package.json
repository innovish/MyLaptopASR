{
  "name": "funasr-local-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "install:python": "python -m pip install -r worker/requirements.txt"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.6.0",
    "concurrently": "9.2.1",
    "express": "5.1.0",
    "multer": "2.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.5",
    "vite": "6.3.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3"
  }
}
